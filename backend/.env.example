# ── Database ──
DATABASE_URL=postgresql+asyncpg://hscode_user:your_password@localhost:5432/hscode_db
DATABASE_URL_SYNC=postgresql+psycopg2://hscode_user:your_password@localhost:5432/hscode_db

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Dataset ──
DATASET_CSV_PATH=../all_chapters_extracted.csv

# ── Firebase ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Embedding Model ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
