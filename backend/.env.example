# ══════════════════════════════════════════════════════════════════════════
# HS Code Search Engine – Environment Configuration
# ══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to version control (it's in .gitignore).
# ══════════════════════════════════════════════════════════════════════════

# ── Environment ──
# "development" enables: dev-token auth bypass, human-readable logs, /docs UI
# "production"  enables: JSON logs, no dev-tokens, /docs hidden
ENV=production

# ── Database ──
# For production on the Droplet (use absolute paths):
DATABASE_URL=sqlite+aiosqlite:////root/ceylonhs/backend/data/hscode.db
DATABASE_URL_SYNC=sqlite:////root/ceylonhs/backend/data/hscode.db
# For local dev (relative paths):
# DATABASE_URL=sqlite+aiosqlite:///./data/hscode.db
# DATABASE_URL_SYNC=sqlite:///./data/hscode.db

# ── FAISS / Data ──
# Production (absolute path):
CHROMA_PERSIST_DIR=/root/ceylonhs/backend/data/chroma_db
# Local dev:
# CHROMA_PERSIST_DIR=./data/chroma_db

# ── Dataset CSV (only needed for re-indexing) ──
DATASET_CSV_PATH=../all_chapters_extracted.csv

# ── Firebase Authentication ──
FIREBASE_PROJECT_ID=ceylon-hs
# Production (absolute path):
FIREBASE_CREDENTIALS_PATH=/root/ceylonhs/backend/firebase-service-account.json
# Local dev:
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Server ──
HOST=127.0.0.1
PORT=8000

# CORS – list your frontend origin(s). Use ["*"] only for development.
CORS_ORIGINS=["*"]

# ── Embedding Model ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Search Backend ──
SEARCH_BACKEND=faiss

# ── LLM Enrichment (multi-provider cascade: Groq -> Gemini -> Cohere) ──
# At least one key is needed for brand-name resolution.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
COHERE_API_KEY=
COHERE_MODEL=command-r
ENRICHMENT_CONFIDENCE_THRESHOLD=0.35

# ── Rate Limiting ──
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_DEFAULT=60/minute
