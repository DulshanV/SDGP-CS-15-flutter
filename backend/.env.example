# ── Database ──
DATABASE_URL=postgresql+asyncpg://hscode_user:your_password@localhost:5432/hscode_db
DATABASE_URL_SYNC=postgresql+psycopg2://hscode_user:your_password@localhost:5432/hscode_db

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Dataset ──
DATASET_CSV_PATH=../all_chapters_extracted.csv

# ── Firebase ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Embedding Model ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Search Backend (typesense | faiss) ──
SEARCH_BACKEND=faiss

# ── Typesense ──
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=hs_codes

# ── Gemini Enrichment ──
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
ENRICHMENT_CONFIDENCE_THRESHOLD=0.35
