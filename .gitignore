# ==============================================================
# .gitignore for CeylonHS
# Focus: keep deploy-safe code in git, drop generated/local files
# ==============================================================

# --- Academic reports and coursework artifacts ---
report/
Extracted base files for report/
CW2_Implementation_Report.md
CeylonHS_CW2_Implementation_Report.*
_cw1_report.txt
_cw2_rubric.txt
_cw2_template.txt
_extract_pdfs.py
all_chapters_extracted.csv

# --- Development logs/docs (local planning only) ---
DECISION_LOG.md
FAILURE_LOG.md
UI_DECISION_LOG.md
UI_OVERHAUL_PLAN.md

# --- Legacy/duplicate roots ---
SDGP-CS-15-flutter/
SDGP-CS-15-flutter-main/
SDGP-main/

# --- Environment and secrets ---
**/.env
**/.env.*
!backend/.env.example
!**/.env.local.example

# --- Python cache and virtual environments ---
backend/venv/
backend/.venv/
backend/.pytest_cache/
**/__pycache__/
**/*.py[cod]

# --- Databases and vector indexes (rebuildable/generated) ---
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.sqlite3
backend/data/chroma_db/
backend/hscode_dev.db
backend/hscode_dev.db-shm
backend/hscode_dev.db-wal
backend/db_backup/

# --- Logs ---
backend/*.log
backend/*.txt
!backend/README.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Typesense generated data ---
backend/typesense-data/
backend/typesense/

# --- ML and model caches ---
*.bin
*.onnx
*.pt
*.pth
*.h5
*.pkl
*.pickle
*.npy
*.npz
*.safetensors
*.sst
**/.cache/
**/sentence-transformers/
**/huggingface/

# --- Firebase credentials ---
backend/firebase-service-account.json

# --- Next.js build artifacts ---
Nextjs/nextjs/node_modules/
Nextjs/nextjs/.next/
Nextjs/nextjs/out/
Nextjs/nextjs/build/

# --- Flutter and Gradle build artifacts ---
flutter_application_1/.dart_tool/
flutter_application_1/.flutter-plugins
flutter_application_1/.flutter-plugins-dependencies
flutter_application_1/build/
flutter_application_1/android/.gradle/
flutter_application_1/android/local.properties
flutter_application_1/ios/Flutter/ephemeral/
flutter_application_1/macos/Flutter/ephemeral/
flutter_application_1/linux/flutter/ephemeral/
flutter_application_1/windows/flutter/ephemeral/

# Generated plugin registrants (frequent merge-conflict sources)
flutter_application_1/linux/flutter/generated_plugin_registrant.*
flutter_application_1/linux/flutter/generated_plugins.cmake
flutter_application_1/windows/flutter/generated_plugin_registrant.*
flutter_application_1/windows/flutter/generated_plugins.cmake
flutter_application_1/macos/Flutter/GeneratedPluginRegistrant.swift

# --- IDE/OS ---
.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# --- CI/Test artifacts ---
backend/ci_test.db
backend/ci_test.db-shm
backend/ci_test.db-wal
backend/*_test.db

# --- Backend junk files ---
backend/d

flutter_application_1/NUL
